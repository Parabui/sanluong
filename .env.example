# ─────────────────────────────────────────────────────────────
# Mẫu biến môi trường. Copy thành `.env` (quyền 600, KHÔNG commit).
# Dev: `infra/compose.yml` và `apps/api` cùng đọc file này.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (container) ──
POSTGRES_PASSWORD=doi-mat-khau-superuser
# 3 tài khoản tách quyền [D9] — tạo bởi infra/postgres/init/01-tai-khoan.sh
VSN_APP_PASSWORD=doi-mat-khau-app
VSN_MIGRATE_PASSWORD=doi-mat-khau-migrate
VSN_BACKUP_PASSWORD=doi-mat-khau-backup
# Cổng PostgreSQL dev trên máy (đổi nếu 5432 đã bị chiếm — nhớ sửa cả 2 URL bên dưới)
VSN_PG_PORT=5432

# ── API ──
# Lúc chạy: tài khoản vsn_app (không có quyền DDL)
DATABASE_URL=postgresql://vsn_app:doi-mat-khau-app@127.0.0.1:5432/vsn_sanluong
# Migration: tài khoản vsn_migrate (chủ schema)
MIGRATE_DATABASE_URL=postgresql://vsn_migrate:doi-mat-khau-migrate@127.0.0.1:5432/vsn_sanluong
# Pool kết nối [D25]
DB_POOL_MAX=20
DB_POOL_TIMEOUT_MS=10000
API_PORT=4000
LOG_LEVEL=info
APP_VERSION=0.1.0-dev

# ── Production (compose.prod.yml) ──
VSN_REGISTRY=ghcr.io/vsn-dn
VSN_TAG=v0.1.0
TUNNEL_TOKEN=
TURNSTILE_SECRET=
SENTRY_DSN=

# ── Superadmin đầu tiên (chỉ dùng khi chạy seed lần đầu; xóa khỏi .env sau khi đã đổi mật khẩu) ──
VSN_SUPERADMIN_TEN=admin
VSN_SUPERADMIN_HO_TEN=Superadmin
# Mật khẩu TẠM: ≥ 8 ký tự, có chữ và số — bắt buộc đổi ở lần đăng nhập đầu
VSN_SUPERADMIN_MAT_KHAU_TAM=
