# ════════════════════════════════════════════════════════════════
# Định tuyến theo đường dẫn [D2] [TDD 2.2]
#   /api/*     → api:4000
#   /quanly/*  → web/dist (SPA, base /quanly/)
#   /tv        → 302 /quanly/tv
#   /*         → worker/dist (PWA, SPA)
# HTTPS do Cloudflare đảm nhận; Caddy chỉ nhận kết nối từ cloudflared trong mạng Docker.
# Header bảo mật theo checklist TDD 19:
#   CSP chỉ cho phép `self` + Sentry (*.ingest.sentry.io); app công nhân thêm Cloudflare Turnstile (script + iframe).
#   style-src cần 'unsafe-inline' cho thuộc tính style của React. Permissions-Policy: camera chỉ cho app công nhân (quét QR).
# ════════════════════════════════════════════════════════════════
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		# API chỉ trả JSON / file — không cho chạy gì
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:4000
	}

	redir /tv /quanly/tv 302
	redir /quanly /quanly/ 308

	handle_path /quanly/* {
		root * /srv/web
		@coHash path /assets/*
		@khongHash not path /assets/*
		header @coHash Cache-Control "public, max-age=31536000, immutable"
		header @khongHash Cache-Control "no-cache"
		header Permissions-Policy "camera=(), microphone=(), geolocation=()"
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/worker
		@coHash path /assets/*
		@khongHash not path /assets/*
		header @coHash Cache-Control "public, max-age=31536000, immutable"
		header @khongHash Cache-Control "no-cache"
		# Camera chỉ cho app công nhân (quét QR trạm)
		header Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob: mediastream:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}
}
