<mxfile host="app.diagrams.net" type="device"><diagram id="p2state" name="Vòng đời ngày sản lượng"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s101" value="&lt;b&gt;Vòng đời một ngày sản lượng&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#686868'&gt;VSN Sản Lượng · TDD v1.1 · trạng thái của ô = chốt (chuyền × ngày) + khóa (mã hàng × tháng)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="s102" value="" style="ellipse;fillColor=#686868;strokeColor=#686868;" vertex="1" parent="1"><mxGeometry x="30" y="163" width="24" height="24" as="geometry"/></mxCell><mxCell id="s103" value="&lt;b&gt;MỞ NHẬP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left;font-size:12px'&gt;✅ Công nhân nhập&lt;br&gt;✅ Tổ trưởng sửa / nhập hộ&lt;br&gt;❌ Chốt ngày&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=top;spacingTop=8;fillColor=#FFFFFF;strokeColor=#F29830;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="100" width="250" height="150" as="geometry"/></mxCell><mxCell id="s104" value="&lt;b&gt;CHỜ CHỐT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left;font-size:12px'&gt;✅ Công nhân nhập (đệm cho người nhập khuya)&lt;br&gt;✅ Tổ trưởng sửa / nhập hộ&lt;br&gt;✅ Chốt ngày&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=top;spacingTop=8;fillColor=#FFFFFF;strokeColor=#F29830;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="250" height="150" as="geometry"/></mxCell><mxCell id="s105" value="&lt;b&gt;ĐÃ CHỐT&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left;font-size:12px'&gt;❌ Công nhân nhập → nhờ tổ trưởng&lt;br&gt;✅ Tổ trưởng sửa / nhập hộ (bắt buộc lý do)&lt;br&gt;❌ Bỏ chốt (không có thao tác này)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=top;spacingTop=8;fillColor=#FDEBD3;strokeColor=#F29830;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="730" y="100" width="250" height="150" as="geometry"/></mxCell><mxCell id="s106" value="&lt;b&gt;ĐÃ KHÓA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left;font-size:12px'&gt;❌ Mọi thao tác ghi sản lượng&lt;br&gt;❌ Sửa / duyệt giờ làm&lt;br&gt;✅ Xuất dữ liệu lương (F15)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;verticalAlign=top;spacingTop=8;fillColor=#686868;strokeColor=#686868;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="250" height="150" as="geometry"/></mxCell><mxCell id="s107" value="00:00 ngày D" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;" edge="1" parent="1" source="s102" target="s103"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s108" value="08:00 sáng D+1&lt;br&gt;(giờ mở chốt, CauHinh)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;" edge="1" parent="1" source="s103" target="s104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s109" value="Tổ trưởng chốt&lt;br&gt;(chuyền × ngày)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;strokeColor=#F29830;strokeWidth=2;" edge="1" parent="1" source="s104" target="s105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s110" value="IT/HR khóa&lt;br&gt;(mã hàng × tháng)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;strokeColor=#F29830;strokeWidth=2;" edge="1" parent="1" source="s105" target="s106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s111" value="Mở khóa — bắt buộc lý do, ghi audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="s106" target="s105"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1165" y="300"/><mxPoint x="855" y="300"/></Array></mxGeometry></mxCell><mxCell id="s112" value="&lt;b&gt;Điều kiện khóa:&lt;/b&gt; mọi (chuyền, ngày) có sản lượng của mã hàng trong tháng đều đã chốt. Nếu chưa → trả danh sách ngày chưa chốt.&lt;br&gt;&lt;b&gt;Khóa theo mã hàng:&lt;/b&gt; trong cùng (chuyền, ngày), ô của mã hàng A có thể ĐÃ KHÓA trong khi ô của mã hàng B mới ĐÃ CHỐT." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6EA;strokeColor=#F29830;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="110" y="340" width="620" height="90" as="geometry"/></mxCell><mxCell id="s113" value="&lt;b&gt;Chốt là chốt luôn:&lt;/b&gt; không có Bỏ chốt. Trước khi chốt, hệ thống cảnh báo danh sách ô chưa có số và yêu cầu giờ chờ duyệt; tổ trưởng phải xác nhận. Chốt nhầm → tổ trưởng tự nhập hộ." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6EA;strokeColor=#F29830;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="750" y="340" width="540" height="90" as="geometry"/></mxCell><mxCell id="s114" value="&lt;b&gt;Dòng thời gian ví dụ&lt;/b&gt; (chuyền 3, ngày 28/09)" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="110" y="480" width="600" height="24" as="geometry"/></mxCell><mxCell id="s115" value="" style="rounded=0;fillColor=#686868;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="110" y="540" width="1180" height="4" as="geometry"/></mxCell><mxCell id="s116" value="" style="ellipse;fillColor=#F29830;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="103" y="535" width="14" height="14" as="geometry"/></mxCell><mxCell id="s117" value="&lt;b&gt;28/09 07:30&lt;/b&gt;&lt;br&gt;&lt;font color='#686868'&gt;Bắt đầu ca&lt;/font&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="35" y="555" width="150" height="44" as="geometry"/></mxCell><mxCell id="s118" value="" style="ellipse;fillColor=#F29830;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="323" y="535" width="14" height="14" as="geometry"/></mxCell><mxCell id="s119" value="&lt;b&gt;28/09 16:30&lt;/b&gt;&lt;br&gt;&lt;font color='#686868'&gt;Tan ca — ~500 người Lưu&lt;/font&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="255" y="555" width="150" height="44" as="geometry"/></mxCell><mxCell id="s120" value="" style="ellipse;fillColor=#F29830;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="553" y="535" width="14" height="14" as="geometry"/></mxCell><mxCell id="s121" value="&lt;b&gt;29/09 00:00&lt;/b&gt;&lt;br&gt;&lt;font color='#686868'&gt;Qua nửa đêm, CN vẫn nhập&lt;/font&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="485" y="555" width="150" height="44" as="geometry"/></mxCell><mxCell id="s122" value="" style="ellipse;fillColor=#F29830;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="783" y="535" width="14" height="14" as="geometry"/></mxCell><mxCell id="s123" value="&lt;b&gt;29/09 08:00&lt;/b&gt;&lt;br&gt;&lt;font color='#686868'&gt;Mở chốt&lt;/font&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="715" y="555" width="150" height="44" as="geometry"/></mxCell><mxCell id="s124" value="" style="ellipse;fillColor=#F29830;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="993" y="535" width="14" height="14" as="geometry"/></mxCell><mxCell id="s125" value="&lt;b&gt;29/09 09:15&lt;/b&gt;&lt;br&gt;&lt;font color='#686868'&gt;Tổ trưởng chốt&lt;/font&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="925" y="555" width="150" height="44" as="geometry"/></mxCell><mxCell id="s126" value="" style="ellipse;fillColor=#F29830;strokeColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1223" y="535" width="14" height="14" as="geometry"/></mxCell><mxCell id="s127" value="&lt;b&gt;02/10&lt;/b&gt;&lt;br&gt;&lt;font color='#686868'&gt;IT/HR khóa MH × T9&lt;/font&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1155" y="555" width="150" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>