hóa&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#686868'&gt;Advisory lock (pg_advisory_xact_lock[_shared]) và khóa dòng — áp dụng cho mọi luồng ghi&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell><mxCell id="c39" value="&lt;table style=&quot;border-collapse:collapse;font-size:13px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#F29830;color:#FFFFFF;text-align:left;&quot;&gt;Thao tác&lt;/th&gt;&lt;th style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#F29830;color:#FFFFFF;text-align:left;&quot;&gt;(CN, chuyền, ngày)&lt;/th&gt;&lt;th style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#F29830;color:#FFFFFF;text-align:left;&quot;&gt;(MH, mã hàng, tháng)&lt;/th&gt;&lt;th style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#F29830;color:#FFFFFF;text-align:left;&quot;&gt;Dòng phien_tram&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Lưu từ app&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Chia sẻ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Chia sẻ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;FOR SHARE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Sửa Web / Nhập hộ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Chia sẻ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Chia sẻ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Sửa / duyệt giờ làm&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Chia sẻ (mọi mã hàng của NV trong ngày)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;&lt;b&gt;Chốt ngày&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FDEBD3;color:#333333;text-align:left;&quot;&gt;&lt;b&gt;ĐỘC QUYỀN&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;&lt;b&gt;Khóa / mở khóa tháng&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FDEBD3;color:#333333;text-align:left;&quot;&gt;&lt;b&gt;ĐỘC QUYỀN&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;&lt;b&gt;Đổi SMV lùi ngày&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FDEBD3;color:#333333;text-align:left;&quot;&gt;&lt;b&gt;ĐỘC QUYỀN&lt;/b&gt; (mọi tháng ảnh hưởng, tăng dần)&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;Chuyển phiên / Đăng xuất hộ&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #BBBBBB;padding:8px 10px;background:#FFFFFF;color:#333333;text-align:left;&quot;&gt;FOR UPDATE&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1100" height="330" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Quy tắc thứ tự (chống deadlock):&lt;/b&gt; CN → MH (tăng dần) → khóa dòng. Không thao tác nào lấy khóa theo chiều ngược lại.&lt;br&gt;&lt;b&gt;Vì sao Lưu dùng khóa CHIA SẺ:&lt;/b&gt; 30–35 công nhân/chuyền Lưu cùng lúc khi tan ca chạy song song; xung đột trên cùng một ô do ràng buộc mức dòng xử lý (ON CONFLICT, version, UNIQUE)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6EA;strokeColor=#F29830;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="1100" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>