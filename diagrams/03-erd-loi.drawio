<mxfile host="app.diagrams.net" type="device"><diagram id="p3erd" name="ERD lõi"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e201" value="&lt;b&gt;ERD lõi nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#686868'&gt;VSN Sản Lượng · TDD v1.1 · 19 bảng · bảng hệ thống (TaiKhoan, PhienDangNhap, AuditLog…) xem ERD tự sinh từ schema.prisma&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="e202" value="&lt;div style='background:#686868;color:#fff;padding:5px 8px;font-weight:bold;font-size:13px'&gt;Xuong&lt;/div&gt;&lt;div style='padding:6px 8px;text-align:left;font-size:11px;line-height:1.45'&gt;🔑 id&lt;br&gt;ma (UNIQUE) · ten&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;spacing=0;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#686868;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="210" height="74" as="geometry"/></mxCell><mxCell id="e203" value="&lt;div style='background:#686868;color:#fff;padding:5px 8px;font-weight:bold;font-size:13px'&gt;Chuyen&lt;/div&gt;&lt;div style='padding:6px 8px;text-align:left;font-size:11px;line-height:1.45'&gt;🔑 id&lt;br&gt;FK xuongId&lt;br&gt;ma · ten · loai&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;spacing=0;verticalAlign=top;align=left;fillColor=#FFFFFF;strokeColor=#686868;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="210" height="90" as="geometry"/></mxCell><mxCell id="e204" value="&lt;div style='background:#686868;color:#fff;padding:5px 8px;font-weight:bold;font-size:13px'&gt;Tram&lt;/div&gt;&lt;div style='padding:6px 8px;text-align:left;font-size:11px;line-height:1.45