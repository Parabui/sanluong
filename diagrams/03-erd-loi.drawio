style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="200" height="20" as="geometry"/></mxCell><mxCell id="e248" value="Danh mục" style="rounded=0;html=1;fillColor=#686868;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1128" width="150" height="26" as="geometry"/></mxCell><mxCell id="e249" value="Sơ đồ &amp;amp; phiên" style="rounded=0;html=1;fillColor=#C9772A;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="1128" width="150" height="26" as="geometry"/></mxCell><mxCell id="e250" value="Sản lượng &amp;amp; giờ làm" style="rounded=0;html=1;fillColor=#F29830;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="1128" width="150" height="26" as="geometry"/></mxCell><mxCell id="e251" value="Chốt &amp;amp; khóa" style="rounded=0;html=1;fillColor=#3D3D3D;fontColor=#FFFFFF;strokeColor=none;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="1128" width="150" height="26" as="geometry"/></mxCell><mxCell id="e252" value="" style="line;html=1;strokeColor=#686868;" vertex="1" parent="1"><mxGeometry x="700" y="1140" width="60" height="1" as="geometry"/></mxCell><mxCell id="e253" value="Quan hệ khóa ngoại (1 – n)" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="1130" width="200" height="20" as="geometry"/></mxCell><mxCell id="e254" value="" style="line;html=1;strokeColor=#F29830;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="1170" width="60" height="1" as="geometry"/></mxCell><mxCell id="e255" value="Quan hệ logic qua cột snapshot — KHÔNG join để lấy giá trị hiện tại" style="text;html=1;align=left;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="1160" width="480" height="20" as="geometry"/></mxCell><mxCell id="e256" value="&lt;b&gt;Quy tắc snapshot:&lt;/b&gt; chuyền của bản ghi = &lt;b&gt;chuyenTramSnapshot&lt;/b&gt; (không join Tram → Chuyen hiện tại). Chuyền gốc NV ngày D = hàm &lt;b&gt;chuyen_goc_ngay(nv, d)&lt;/b&gt; đọc NhanVienChuyenGoc. SMV = &lt;b&gt;smvSnapshot&lt;/b&gt;; chỉ đổi qua luồng Đổi SMV lùi (8.6)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6EA;strokeColor=#F29830;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1210" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>