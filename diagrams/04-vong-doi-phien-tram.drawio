<mxfile host="app.diagrams.net" type="device"><diagram id="p4phien" name="Vòng đời phiên trạm"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f301" value="&lt;b&gt;Vòng đời phiên trạm&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#686868'&gt;VSN Sản Lượng · TDD v1.1 · mục 8.1, 9.1 · phiên luôn có ngày = homNay() do server tính&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="f302" value="" style="ellipse;fillColor=#686868;strokeColor=#686868;" vertex="1" parent="1"><mxGeometry x="40" y="228" width="24" height="24" as="geometry"/></mxCell><mxCell id="f303" value="&lt;b&gt;ĐANG HOẠT ĐỘNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;✅ Giữ trạm (độc quyền: 1 trạm × ngày = 1 phiên)&lt;br&gt;✅ Lưu số cho trạm, ngày D&lt;br&gt;Hiện trên F17 sơ đồ trạm trực tiếp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=top;spacingTop=8;align=center;fillColor=#FFFFFF;strokeColor=#F29830;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="200" y="160" width="320" height="160" as="geometry"/></mxCell><mxCell id="f304" value="&lt;b&gt;ĐÃ ĐÓNG&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;❌ Lưu số → 409 PHIEN_KHONG_CON&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(app giữ số trên form) [R 3.8]&lt;br&gt;Thay đổi sau đó → tổ trưởng nhập hộ&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=top;spacingTop=8;align=center;fillColor=#FDEBD3;strokeColor=#F29830;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="320" height="140" as="geometry"/></mxCell><mxCell id="f305" value="&lt;b&gt;HẾT HIỆU LỰC&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style='text-align:left'&gt;❌ Lưu số → 409 NGAY_DA_CHOT&lt;br&gt;Kiểm tra lúc Lưu, không cần job&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=12;verticalAlign=top;spacingTop=8;align=center;fillColor=#686868;strokeColor=#686868;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="820" y="300" width="320" height="110" as="geometry"/></mxCell><mxCell id="f306" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#686868;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1250" y="228" width="24" height="24" as="geometry"/></mxCell><mxCell id="f307" value="Đăng nhập trạm (mã NV)&lt;br&gt;+ Turnstile" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;" edge="1" parent="1" source="f302" target="f303"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f308" value="&lt;b&gt;Chuyển thiết bị&lt;/b&gt; — cùng mã NV, ≤ 3 lần/ngày&lt;br&gt;đóng dòng cũ + INSERT dòng mới · audit CHUYEN_THIET_BI&lt;br&gt;máy cũ báo: “Phiên đã chuyển sang thiết bị khác lúc hh:mm”" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;strokeColor=#F29830;exitX=0.25;exitY=0;entryX=0.75;entryY=0;" edge="1" parent="1" source="f303" target="f303"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="110"/><mxPoint x="440" y="110"/></Array></mxGeometry></mxCell><mxCell id="f309" value="Tự đăng xuất&lt;br&gt;(app chặn nếu còn số chưa Lưu)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1" source="f303" target="f304"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f310" value="&lt;b&gt;Tổ trưởng đăng xuất hộ (F17)&lt;/b&gt;&lt;br&gt;cảnh báo nếu NV chưa có số hôm nay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;strokeColor=#F29830;strokeWidth=2;exitX=1;exitY=0.6;entryX=0;entryY=0.8;" edge="1" parent="1" source="f303" target="f304"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f311" value="Tổ trưởng chốt ngày D" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;exitX=0.75;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="f303" target="f305"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="355"/></Array></mxGeometry></mxCell><mxCell id="f312" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;exitX=1;exitY=0.5;" edge="1" parent="1" source="f304" target="f306"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f313" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#686868;exitX=1;exitY=0.5;" edge="1" parent="1" source="f305" target="f306"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f314" value="&lt;b&gt;Quy trình khi điều chuyển công nhân giữa ngày&lt;/b&gt;&lt;br&gt;1. Tổ trưởng mở F17 → chọn trạm → &lt;b&gt;Đăng xuất hộ&lt;/b&gt;.&lt;br&gt;2. Hệ thống cảnh báo nếu NV chưa có số hôm nay tại trạm: “Ng. T. Lan chưa nhập số tại trạm 12”.&lt;br&gt;3. NV &lt;b&gt;nhập số ở trạm cũ trước&lt;/b&gt; (phiên vẫn còn, nhập được từ bất kỳ đâu).&lt;br&gt;4. Tổ trưởng xác nhận đăng xuất (vẫn đăng xuất được nếu bắt buộc — sau đó nhập hộ).&lt;br&gt;5. Người mới đăng nhập trạm." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6EA;strokeColor=#F29830;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="200" y="450" width="620" height="140" as="geometry"/></mxCell><mxCell id="f315" value="&lt;b&gt;Công nhân KHÔNG có nút “Đăng xuất người đang giữ”.&lt;/b&gt;&lt;br&gt;Trạm đang có người → “Trạm đang có Ng. T. Lan – báo tổ trưởng” (chỉ tên viết tắt).&lt;br&gt;&lt;br&gt;&lt;b&gt;Mỗi lần chuyển trạng thái đều ghi audit&lt;/b&gt; (DANG_NHAP_TRAM, CHUYEN_THIET_BI, DANG_XUAT_TRAM, DANG_XUAT_HO)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF6EA;strokeColor=#F29830;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="450" width="440" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>